APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Shared Records API keys (comma-separated, one per client app, e.g. pbo-registryV2)
RECORDS_API_KEYS=

# Nightly backups (php artisan backup:run; see docs/backups.md). Put BACKUP_PATH on another drive or a network share.
BACKUP_PATH=
BACKUP_KEEP_DAYS=30
# mysqldump on PATH, or its full path, e.g. D:\xampp\mysql\bin\mysqldump.exe
BACKUP_MYSQLDUMP=mysqldump
# A second copy of every backup OFF this server (another PC's shared folder or a NAS), e.g. \\192.168.2.25\backups\pbo-mbm
BACKUP_COPY_PATH=
BACKUP_COPY_KEEP_DAYS=30

# Shared Leaves API keys (separate from the Records keys; an employee's own leave summary, e.g. for pbo-registryV2 profiles)
LEAVES_API_KEYS=
